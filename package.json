{
  "name": "pteron",
  "productName": "pteron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:feasibility": "node scripts/feasibility.mjs",
    "test:unit": "tsx --test tests/*.test.ts && npm run test:python",
    "setup:tex": "powershell -NoProfile -File scripts/setup-tex.ps1",
    "test:python": "node scripts/python.mjs -m unittest discover -s tests -v",
    "python": "node scripts/python.mjs",
    "benchmark:export": "node scripts/python.mjs -m scripts.benchmark_export",
    "test:simple-authoring": "tsx scripts/simple-authoring-ui-test.ts",
    "test:video-authoring": "tsx scripts/video-authoring-test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "mcp": "node dist/mcp.js",
    "test:startup": "node scripts/startup-test.mjs",
    "dev:status": "node scripts/dev-status.mjs",
    "test:dev": "node scripts/dev-test.mjs",
    "test:desktop": "tsx scripts/desktop-test.ts",
    "test:layer-timing": "tsx scripts/layer-timing-test.ts",
    "test:timeline-hierarchy": "tsx scripts/timeline-hierarchy-test.ts",
    "test:motion-fidelity": "tsx scripts/motion-fidelity.ts",
    "build:standalone": "powershell -NoProfile -File scripts/build-standalone.ps1",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-standalone.ps1 -Portable",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-standalone.ps1 -Installer",
    "example:create": "tsx scripts/create-showcase.ts",
    "test:example": "tsx scripts/example-acceptance.ts",
    "test:standalone": "tsx scripts/example-acceptance.ts --packaged",
    "test:portable": "tsx scripts/portable-test.ts",
    "test:narration-playback": "tsx scripts/narration-playback-test.ts",
    "test:replay": "tsx scripts/replay-test.ts",
    "test:timeline-layout": "tsx scripts/timeline-layout-test.ts",
    "test:navigation": "tsx scripts/navigation-test.ts",
    "test:workspace": "tsx scripts/workspace-test.ts",
    "test:workspace:standalone": "tsx scripts/workspace-test.ts --packaged",
    "test:ui-refinement": "tsx scripts/ui-refinement-test.ts",
    "test:interface-polish": "tsx scripts/interface-polish-test.ts",
    "test:compact-inspector": "tsx scripts/compact-inspector-test.ts",
    "test:animation-authoring-ui": "tsx scripts/animation-authoring-ui-test.ts",
    "test:animation-authoring-render": "tsx scripts/animation-authoring-render-test.ts",
    "test:scenes": "tsx scripts/scenes-test.ts",
    "test:sequence-timeline": "tsx scripts/sequence-timeline-test.ts",
    "test:workspace-chrome": "tsx scripts/workspace-chrome-test.ts",
    "test:multi-selection": "tsx scripts/multi-selection-test.ts",
    "test:selection": "tsx scripts/selection-regression-test.ts",
    "test:editor-ux": "tsx scripts/editor-ux-test.ts",
    "test:editor-workflow": "tsx scripts/editor-workflow-test.ts",
    "test:stroke-settings": "tsx scripts/stroke-settings-test.ts",
    "test:shapes": "tsx scripts/shape-inspector-test.ts",
    "test:shapes:standalone": "tsx scripts/shape-inspector-test.ts --packaged",
    "test:project-settings": "tsx scripts/project-settings-test.ts",
    "test:properties": "tsx scripts/properties-caption-test.ts",
    "test:layers": "tsx scripts/layer-menu-test.ts",
    "test:panels": "tsx scripts/panels-test.ts",
    "test:panels:standalone": "tsx scripts/panels-test.ts --packaged",
    "test:application-menu": "tsx scripts/application-menu-test.ts",
    "test:shape-usability": "tsx scripts/shape-usability-test.ts",
    "test:cache-startup": "tsx scripts/cache-startup-test.ts"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-menubar": "1.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@svgedit/svgcanvas": "7.4.2",
    "@xmldom/xmldom": "0.9.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "lucide-react": "1.61.0",
    "mathjax-full": "^3.2.1",
    "pathkit-wasm": "1.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svgpath": "2.6.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/fontkit": "2.0.9",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "main": "dist/electron/main.js"
}
